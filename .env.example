# Circlo Environment Configuration

# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=django-insecure-circlo-change-in-production-key-secret-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

# Database Configuration (PostgreSQL)
POSTGRES_DB=circlo_db
POSTGRES_USER=circlo_user
POSTGRES_PASSWORD=circlo_secure_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
DATABASE_URL=postgres://circlo_user:circlo_secure_password@127.0.0.1:5433/circlo_db

# Redis & Channels Configuration
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380/1
REDIS_CHANNEL_URL=redis://127.0.0.1:6380/2

# Celery Configuration
CELERY_BROKER_URL=redis://127.0.0.1:6380/3
CELERY_RESULT_BACKEND=redis://127.0.0.1:6380/4

# Frontend & CORS
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173

# Ports
WEB_PORT=8000
VITE_PORT=5173
